# OpenAI-compatible LLM endpoint
OPENAI_BASE_URL=https://your-endpoint/v1
OPENAI_API_KEY=sk-...
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0

# Optional overrides (defaults shown, relative to this folder)
GOAL_FILE=goal.md
PROMPT_FILE=prompt.md
MCP_CONFIG=mcp.json
KNOWLEDGE_DIR=knowledge
WORKSPACE_DIR=workspace
# max tool rounds (one model call + its tool calls)
MAX_STEPS=50

# LLM — any provider supported by LangChain's init_chat_model (openai, anthropic, ollama, ...)
# "openai" also covers every OpenAI-compatible endpoint (Groq, Together, vLLM, LM Studio, ...)
LLM_PROVIDER=openai
LLM_MODEL=your-model-name
# optional: custom endpoint and key (otherwise the provider's own env vars are used)
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=sk-...
LLM_TEMPERATURE=0

# Optional overrides (defaults shown, relative to this folder)
GOAL_FILE=goal.md
PROMPT_FILE=prompt.md
MCP_CONFIG=mcp.json
SKILLS_DIR=skills
AGENTS_DIR=agents
WORKSPACE_DIR=workspace
# max model calls for the main agent (default for sub-agents too)
MAX_STEPS=50
